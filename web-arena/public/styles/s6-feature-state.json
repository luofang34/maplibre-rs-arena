{
  "version": 8,
  "name": "Arena S6 — Dynamic GeoJSON & Expression Stress",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "arena_sensors": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#090d16"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0f1f38"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "paint": {
        "line-color": "#1e293b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 16, 4.0]
      }
    },
    {
      "id": "buildings-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-extrusion-color": "#1e293b",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 16],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.72
      }
    },
    {
      "id": "sensor-pulses",
      "type": "circle",
      "source": "arena_sensors",
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "load"], 0.5],
          0,
          4,
          1,
          13
        ],
        "circle-color": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "load"], 0.5],
          0,
          "#22d3ee",
          0.5,
          "#a855f7",
          1,
          "#f43f5e"
        ],
        "circle-opacity": 0.88,
        "circle-stroke-width": 1,
        "circle-stroke-color": "#f8fafc"
      }
    }
  ]
}
